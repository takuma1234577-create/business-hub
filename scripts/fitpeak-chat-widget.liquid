{%- comment -%}
  FITPEAK AIチャットウィジェット + 公式LINEボタン
  画面右下に常時表示。24時間、商品に関する質問へAIが回答します。
  設置: layout/theme.liquid の </body> 直前に {% render 'fitpeak-chat-widget' %} を追加
{%- endcomment -%}

<div id="fp-chat-root" data-api="https://business-hub-beige.vercel.app/api/public/chat" data-line="https://line.me/R/ti/p/@956iyppc">
  <button id="fp-chat-fab" type="button" aria-label="AIサポートに質問する">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
    <span id="fp-chat-fab-badge">AIに質問</span>
  </button>

  <div id="fp-chat-panel" role="dialog" aria-label="FITPEAK AIサポート" hidden>
    <div id="fp-chat-head">
      <div>
        <p id="fp-chat-title">FITPEAK AIサポート</p>
        <p id="fp-chat-sub">24時間・すぐにお答えします</p>
      </div>
      <button id="fp-chat-close" type="button" aria-label="閉じる">&times;</button>
    </div>

    <div id="fp-chat-log" aria-live="polite"></div>

    <div id="fp-chat-chips">
      <button type="button" data-q="サイズと重さを教えてください">サイズ・重さ</button>
      <button type="button" data-q="どんなトレーニングができますか？">できる種目</button>
      <button type="button" data-q="収納方法を教えてください">収納方法</button>
      <button type="button" data-q="保証と返品について教えてください">保証・返品</button>
    </div>

    <form id="fp-chat-form" autocomplete="off">
      <input id="fp-chat-input" type="text" maxlength="300" placeholder="質問を入力してください" aria-label="質問を入力">
      <button id="fp-chat-send" type="submit" aria-label="送信">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13"/><path d="m22 2-7 20-4-9-9-4 20-7z"/></svg>
      </button>
    </form>

    <a id="fp-chat-line" href="https://line.me/R/ti/p/@956iyppc" target="_blank" rel="noopener">
      <span id="fp-chat-line-icon">LINE</span>
      担当者に相談する（公式LINE）
    </a>
  </div>
</div>

<style>
#fp-chat-root{--fp-rose:#b5707a;--fp-rose-dark:#96505c;--fp-cream:#fdf4f4;--fp-ink:#3a3033;--fp-line:#06c755;
  position:fixed;right:18px;bottom:18px;z-index:2147483000;
  font-family:'Noto Sans JP','Hiragino Kaku Gothic ProN',Meiryo,sans-serif;}
#fp-chat-fab{display:flex;align-items:center;gap:8px;background:var(--fp-rose);color:#fff;border:0;
  border-radius:999px;padding:14px 20px 14px 17px;cursor:pointer;box-shadow:0 8px 24px rgba(0,0,0,.18);
  font-size:15px;font-weight:800;line-height:1;transition:transform .15s ease,background .15s ease;}
#fp-chat-fab:hover{background:var(--fp-rose-dark);transform:translateY(-2px);}
#fp-chat-fab-badge{white-space:nowrap;}
#fp-chat-panel{position:absolute;right:0;bottom:0;width:min(370px,calc(100vw - 32px));
  max-height:min(600px,calc(100vh - 40px));background:#fff;border-radius:18px;overflow:hidden;
  display:flex;flex-direction:column;box-shadow:0 18px 50px rgba(0,0,0,.24);}
#fp-chat-head{background:var(--fp-rose);color:#fff;padding:15px 16px;display:flex;align-items:center;justify-content:space-between;}
#fp-chat-title{margin:0;font-size:16px;font-weight:800;}
#fp-chat-sub{margin:3px 0 0;font-size:12px;opacity:.9;}
#fp-chat-close{background:none;border:0;color:#fff;font-size:26px;line-height:1;cursor:pointer;padding:0 4px;}
#fp-chat-log{flex:1;overflow-y:auto;padding:16px;background:var(--fp-cream);min-height:200px;}
.fp-msg{max-width:84%;padding:11px 14px;border-radius:14px;font-size:14px;line-height:1.75;margin-bottom:10px;white-space:pre-wrap;word-break:break-word;}
.fp-msg.bot{background:#fff;color:var(--fp-ink);border-bottom-left-radius:4px;}
.fp-msg.me{background:var(--fp-rose);color:#fff;margin-left:auto;border-bottom-right-radius:4px;}
.fp-msg.typing{color:#9a9295;font-style:normal;}
#fp-chat-chips{display:flex;gap:6px;flex-wrap:wrap;padding:10px 12px 0;background:#fff;}
#fp-chat-chips button{background:#fff;border:1px solid #f0dcdc;color:var(--fp-rose);border-radius:999px;
  padding:7px 12px;font-size:12.5px;font-weight:700;cursor:pointer;}
#fp-chat-chips button:hover{background:var(--fp-cream);}
#fp-chat-form{display:flex;gap:8px;padding:12px;background:#fff;}
#fp-chat-input{flex:1;border:1px solid #e6dcdc;border-radius:999px;padding:11px 15px;font-size:14px;outline:none;font-family:inherit;}
#fp-chat-input:focus{border-color:var(--fp-rose);}
#fp-chat-send{background:var(--fp-rose);border:0;color:#fff;border-radius:50%;width:42px;height:42px;
  display:flex;align-items:center;justify-content:center;cursor:pointer;flex:0 0 42px;}
#fp-chat-send:disabled{opacity:.45;cursor:default;}
#fp-chat-line{display:flex;align-items:center;justify-content:center;gap:8px;background:var(--fp-line);color:#fff;
  text-decoration:none;padding:13px;font-size:14px;font-weight:800;}
#fp-chat-line-icon{background:#fff;color:var(--fp-line);border-radius:5px;padding:2px 6px;font-size:11px;font-weight:900;letter-spacing:.03em;}
@media (max-width:480px){
  #fp-chat-root{right:12px;bottom:12px;}
  #fp-chat-panel{width:calc(100vw - 24px);max-height:calc(100vh - 24px);}
  #fp-chat-fab{padding:13px 17px;font-size:14px;}
}

/* ---- fp-lp-breakout : 商品説明LPをPCで中央900pxに広げる ---- */
@media (min-width:1250px){
  .product__info-container .product__description > div[style*="Noto Sans JP"]{
    width:900px !important;
    max-width:900px !important;
    margin-left:-585px !important;
    position:relative;
    z-index:1;
  }
  .product__info-container{overflow:visible !important;}
  .product__column-sticky{position:static !important;}
}
</style>

<script>
(function(){
  var root=document.getElementById('fp-chat-root');
  if(!root) return;
  var API=root.dataset.api, LINE=root.dataset.line;
  var fab=document.getElementById('fp-chat-fab');
  var panel=document.getElementById('fp-chat-panel');
  var closeBtn=document.getElementById('fp-chat-close');
  var log=document.getElementById('fp-chat-log');
  var form=document.getElementById('fp-chat-form');
  var input=document.getElementById('fp-chat-input');
  var send=document.getElementById('fp-chat-send');
  var chips=document.getElementById('fp-chat-chips');
  var history=[], busy=false, greeted=false;

  function add(text, who){
    var el=document.createElement('div');
    el.className='fp-msg '+who;
    el.textContent=text;
    log.appendChild(el);
    log.scrollTop=log.scrollHeight;
    return el;
  }

  function open(){
    panel.hidden=false; fab.style.display='none';
    if(!greeted){
      greeted=true;
      add('こんにちは。FITPEAKのAIサポートです。\n商品のサイズ・使い方・保証など、お気軽にご質問ください。','bot');
    }
    setTimeout(function(){ input.focus(); },80);
  }
  function close(){ panel.hidden=true; fab.style.display='flex'; }

  fab.addEventListener('click', open);
  closeBtn.addEventListener('click', close);
  chips.addEventListener('click', function(e){
    var b=e.target.closest('button[data-q]');
    if(b && !busy){ input.value=b.dataset.q; form.requestSubmit(); }
  });

  form.addEventListener('submit', async function(e){
    e.preventDefault();
    var msg=(input.value||'').trim();
    if(!msg || busy) return;
    busy=true; send.disabled=true; input.value='';
    add(msg,'me');
    var typing=add('入力中…','bot typing');

    try{
      var res=await fetch(API,{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({ message:msg, history:history.slice(-8), page:(document.title||'').slice(0,120) })
      });
      var data=await res.json();
      typing.remove();
      var reply=data.reply||'うまくお答えできませんでした。公式LINEからお問い合わせください。';
      add(reply,'bot');
      history.push({role:'user',content:msg});
      history.push({role:'assistant',content:reply});
      if(data.needs_escalation){
        var a=document.createElement('a');
        a.href=data.line_url||LINE; a.target='_blank'; a.rel='noopener';
        a.className='fp-msg bot';
        a.style.cssText='display:block;color:#06c755;font-weight:800;text-decoration:none;';
        a.textContent='▶ 公式LINEで担当者に相談する';
        log.appendChild(a); log.scrollTop=log.scrollHeight;
      }
    }catch(err){
      typing.remove();
      add('通信に失敗しました。お手数ですが公式LINEからお問い合わせください。','bot');
    }finally{
      busy=false; send.disabled=false; input.focus();
    }
  });
})();
</script>
