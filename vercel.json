{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/)(?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/daily-cron",
      "schedule": "*/10 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "my.fitpeak.co"
        }
      ],
      "destination": "/my-fitpeak",
      "permanent": false
    },
    {
      "source": "/line-link",
      "has": [
        {
          "type": "host",
          "value": "my.fitpeak.co"
        }
      ],
      "destination": "/my-fitpeak/line-link",
      "permanent": false
    }
  ]
}
